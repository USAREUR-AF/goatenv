# generated by ops/scripts/goatlite-render.py from goatlite.yaml — edit goatlite.yaml, or remove this line to own the file
#
# The cloud footprint of example-internet, a goatlite grown to the internet (docs/design/goatlite.md §6):
# 2 relay(s) in your own AWS account, each with a public name
# goat-relay-<relay>.goatnet.example, all answering the enrolment apex netbird.goatnet.example
# (Cloudflare round-robin), each carrying the rathole tunnel back to the box.
# Status: WIP, not for production use — gate: one internet standup from the rendered example on real relays.
#
#   cd terraform-example-internet
#   terraform init            # add a backend first if more than one person applies it
#   terraform apply -var aws_account_id=... -var cloudflare_zone_id=...
#
# Credentials: the aws-vault profile example-internet (lite.internet.aws_profile) and
# CLOUDFLARE_API_TOKEN, both through the declared secrets posture. Standup phase 7 then
# runs ops/ansible/inventory/generate-relays.sh example-internet terraform-example-internet, which reads the
# `relays` and `ansible_ssm_bucket` outputs below.

terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

variable "aws_account_id" {
  description = "Your AWS account. Terraform refuses to apply with credentials for any other account."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "The Cloudflare zone id of goatnet.example."
  type        = string
}

variable "cloudflare_zone_name" {
  description = "The goatnet's public zone (lite.internet.zone)."
  type        = string
  default     = "goatnet.example"
}

# One aws provider per relay: Terraform cannot pass a provider to a for_each'd module.
provider "aws" {
  alias               = "a"
  region              = "us-east-2"
  allowed_account_ids = [var.aws_account_id]
}

provider "aws" {
  alias               = "b"
  region              = "eu-west-1"
  allowed_account_ids = [var.aws_account_id]
}

provider "cloudflare" {} # reads CLOUDFLARE_API_TOKEN

module "relay_a" {
  source    = "../terraform/modules/goat-relay"
  providers = { aws = aws.a }

  relay_name              = "a"
  region                  = "us-east-2"
  project                 = "goat"
  environment             = "example-internet"
  cloudflare_zone_id      = var.cloudflare_zone_id
  cloudflare_zone_name    = var.cloudflare_zone_name
  round_robin_dns_name    = "netbird"
  rathole_ingress_enabled = true
  coturn_enabled          = true
}

module "relay_b" {
  source    = "../terraform/modules/goat-relay"
  providers = { aws = aws.b }

  relay_name              = "b"
  region                  = "eu-west-1"
  project                 = "goat"
  environment             = "example-internet"
  cloudflare_zone_id      = var.cloudflare_zone_id
  cloudflare_zone_name    = var.cloudflare_zone_name
  round_robin_dns_name    = "netbird"
  rathole_ingress_enabled = true
  coturn_enabled          = true
}

# The bucket the Ansible SSM connection stages files through when it reaches a relay.
resource "random_id" "ansible_ssm" {
  byte_length = 4
}

resource "aws_s3_bucket" "ansible_ssm" {
  provider = aws.a
  bucket   = "goat-example-internet-ansible-ssm-${random_id.ansible_ssm.hex}"
}

resource "aws_s3_bucket_public_access_block" "ansible_ssm" {
  provider                = aws.a
  bucket                  = aws_s3_bucket.ansible_ssm.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

output "ansible_ssm_bucket" {
  value = aws_s3_bucket.ansible_ssm.id
}

output "relays" {
  value = {
    a = {
      public_ip           = module.relay_a.public_ip
      instance_id         = module.relay_a.instance_id
      region              = "us-east-2"
      relay_url           = module.relay_a.relay_url
      ssh_key_secret_name = module.relay_a.ssh_key_secret_name
      rathole_secret_name = module.relay_a.rathole_secret_name
    }
    b = {
      public_ip           = module.relay_b.public_ip
      instance_id         = module.relay_b.instance_id
      region              = "eu-west-1"
      relay_url           = module.relay_b.relay_url
      ssh_key_secret_name = module.relay_b.ssh_key_secret_name
      rathole_secret_name = module.relay_b.rathole_secret_name
    }
  }
}
